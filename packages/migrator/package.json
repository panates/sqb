{
  "name": "@sqb/migrator",
  "description": "Database migrator for SQB",
  "version": "6.0.9",
  "author": "Panates",
  "license": "BSD-3-Clause",
  "homepage": "https://www.sqbjs.org",
  "scripts": {
    "compile": "tsc --noEmit",
    "prebuild": "npm run check && npm run lint && npm run clean",
    "build": "tsc -b tsconfig-build.json",
    "postbuild": "node ../../support/postbuild.cjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "format": "prettier . --write --log-level=warn",
    "check": "dpdm -T --no-warning --no-tree --skip-dynamic-imports circular --exit-code circular:1 ./src/index.ts",
    "test": "mocha",
    "clean": "npm run clean:src && npm run clean:test && npm run clean:build && npm run clean:cover",
    "clean:src": "ts-cleanup -s src --all",
    "clean:test": "ts-cleanup -s test --all",
    "clean:build": "rimraf build *.tsbuildinfo",
    "clean:cover": "rimraf ../../coverage/migrator"
  },
  "dependencies": {
    "cross-dirname": "^0.1.0",
    "fast-glob": "^3.3.3",
    "strict-typed-events": "^2.8.0",
    "ts-gems": "^4.0.4",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@sqb/builder": "^6.0.9",
    "@sqb/connect": "^6.0.9",
    "@sqb/mariadb": "^6.0.9",
    "@sqb/mssql": "^6.0.9",
    "@sqb/mysql": "^6.0.9",
    "@sqb/oracle": "^6.0.9",
    "@sqb/postgres": "^6.0.9",
    "@sqb/sqlite": "^6.0.9",
    "@sqb/sqljs": "^6.0.9"
  },
  "devDependencies": {
    "@types/oracledb": "^7.0.3",
    "@types/sql.js": "^1.4.11",
    "expect": "^30.5.1",
    "mariadb": "^3.5.4",
    "mssql": "^12.7.2",
    "mysql2": "^3.24.4",
    "oracledb": "^7.0.1",
    "postgrejs": "^3.1.3",
    "sql.js": "^1.14.2"
  },
  "type": "module",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.0"
  },
  "contributors": [
    "Eray Hanoglu <e.hanoglu@panates.com>",
    "Ilker Gurelli <i.gurelli@panates.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/panates/sqb.git",
    "directory": "packages/migrator"
  },
  "keywords": [
    "sqb",
    "sql",
    "query",
    "database",
    "db",
    "migrate",
    "migrator"
  ],
  "publishConfig": {
    "access": "public"
  }
}