{
  "name": "@sqb/mssql",
  "description": "SQB adapter for the mssql (tedious) driver",
  "version": "6.0.3",
  "author": "Panates",
  "license": "Apache-2.0",
  "scripts": {
    "compile": "tsc --noEmit",
    "prebuild": "npm run check && npm run lint && npm run clean",
    "build": "tsc -b tsconfig-build.json",
    "postbuild": "node ../../support/postbuild.cjs",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "format": "prettier . --write --log-level=warn",
    "check": "dpdm -T --no-warning --no-tree ./src/index.ts",
    "test": "mocha",
    "clean": "npm run clean:src && npm run clean:test && npm run clean:build && npm run clean:cover",
    "clean:src": "ts-cleanup -s src --all",
    "clean:test": "ts-cleanup -s test --all",
    "clean:build": "rimraf build *.tsbuildinfo",
    "clean:cover": "rimraf ../../coverage/mssql"
  },
  "dependencies": {
    "fast-tokenizer": "^1.9.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "expect": "^30.4.1",
    "mssql": "^12.7.0"
  },
  "peerDependencies": {
    "@sqb/builder": "^6.0.3",
    "@sqb/connect": "^6.0.3",
    "@sqb/mssql-dialect": "^6.0.3",
    "mssql": "^11.0.0 || ^12.0.0"
  },
  "type": "module",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.0"
  },
  "contributors": [
    "Eray Hanoglu <e.hanoglu@panates.com>",
    "Ilker Gurelli <i.gurelli@panates.com>"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/panates/sqb.git",
    "directory": "packages/mssql"
  },
  "keywords": [
    "sqb",
    "mssql",
    "sql server",
    "tedious",
    "sql",
    "query",
    "builder",
    "dialect",
    "serializer",
    "database"
  ],
  "publishConfig": {
    "access": "public"
  }
}